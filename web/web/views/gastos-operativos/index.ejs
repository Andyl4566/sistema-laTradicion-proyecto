<style>
.go-filtros{background:#fff;border-radius:12px;padding:18px;margin:16px 0;box-shadow:0 3px 15px #0000000b}
.go-filtros form{display:flex;gap:12px;flex-wrap:wrap;align-items:end}
.go-campo{display:flex;flex-direction:column;gap:6px;min-width:130px;flex:1;font-size:13px;font-weight:600;color:#155923}
.go-campo.go-busqueda{flex:2;min-width:190px}
.go-campo input,.go-campo select{width:100%;min-height:38px;padding:9px 11px;border:1px solid #ccd6cf;border-radius:8px;background:#fff;color:#27382a;font:inherit;font-weight:400}
.go-boton{display:inline-flex;gap:6px;align-items:center;justify-content:center;border:0;border-radius:7px;padding:10px 13px;font-weight:700;text-decoration:none;cursor:pointer;font-size:13px;background:#ffb900;color:#142d18}
.go-boton.secundario{background:#e9f0eb;color:#195029}.go-boton.peligro{background:#c62828;color:#fff}
.go-resumen{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:17px 0 0}
.go-resumen .go-indicador{background:#edf6ee;border-radius:9px;padding:13px;color:#155923}
.go-indicador span{display:block;font-size:12px;margin-bottom:5px}.go-indicador strong{font-size:17px}
.go-tabla-wrap{overflow-x:auto}.go-acciones{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.go-acciones form{margin:0}
.go-estado{font-weight:700}.go-estado.pagado{color:#13783a}.go-estado.pendiente{color:#a16b00}.go-estado.anulado{color:#b32626}
@media(max-width:800px){.go-resumen{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.go-resumen{grid-template-columns:1fr}}
</style>
<div class="dashboard-container">
 <div class="section-heading"><div><p class="section-eyebrow">Administración</p><h1 class="section-title">Gastos Operativos</h1><p class="section-description">Registra, consulta y administra los gastos de la empresa.</p></div><a href="/gastos-operativos/nuevo" class="btn btn-module"><i class="fas fa-plus"></i> Nuevo Gasto</a></div>
 <% if(mensaje){ %><div class="alert alert-success"><i class="fas fa-circle-check"></i> <%= mensaje %></div><% } %>
 <% if(error){ %><div class="alert alert-error"><i class="fas fa-triangle-exclamation"></i> <%= error %></div><% } %>
 <div class="go-filtros">
  <form method="GET" action="/gastos-operativos">
   <label class="go-campo go-busqueda" for="go-buscar">Buscar por descripción o motivo<input id="go-buscar" name="busqueda" type="search" placeholder="Buscar gasto..." value="<%= filtros.busqueda %>"></label>
   <label class="go-campo" for="go-categoria">Categoría / descripción<select id="go-categoria" name="categoria"><option value="">Todas</option><% categorias.forEach(c=>{ %><option value="<%= c.descripcion %>" <%= filtros.categoria===c.descripcion?'selected':'' %>><%= c.descripcion %></option><% }) %></select></label>
   <label class="go-campo" for="go-desde">Desde<input id="go-desde" type="date" name="desde" value="<%= filtros.desde %>"></label>
   <label class="go-campo" for="go-hasta">Hasta<input id="go-hasta" type="date" name="hasta" value="<%= filtros.hasta %>"></label>
   <button class="go-boton" type="submit"><i class="fas fa-filter"></i> Filtrar</button><a class="go-boton secundario" href="/gastos-operativos">Limpiar</a>
  </form>
  <% const montoFormato = n => 'Q '+Number(n||0).toLocaleString('es-GT',{minimumFractionDigits:2,maximumFractionDigits:2}); %>
  <% const pagados = registros.filter(g=>g.ESTADO==='Pagado'); const pendientes = registros.filter(g=>g.ESTADO==='Pendiente'); %>
  <% const totalPagado = pagados.reduce((s,g)=>s+Number(g.MONTO||0),0); const totalPendiente = pendientes.reduce((s,g)=>s+Number(g.MONTO||0),0); %>
  <div class="go-resumen">
   <div class="go-indicador"><span>Gastos encontrados</span><strong><%= resumen.cantidad %></strong></div>
   <div class="go-indicador"><span>Total del período filtrado</span><strong><%= montoFormato(resumen.total) %></strong></div>
   <div class="go-indicador"><span>Pagados (<%= pagados.length %>)</span><strong><%= montoFormato(totalPagado) %></strong></div>
   <div class="go-indicador"><span>Pendientes (<%= pendientes.length %>)</span><strong><%= montoFormato(totalPendiente) %></strong></div>
  </div>
 </div>
 <div class="table-container go-tabla-wrap"><table class="data-table"><thead><tr><th>ID</th><th>Descripción</th><th>Motivo</th><th>Fecha</th><th>Monto</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
 <% if(!registros.length){ %><tr><td colspan="7" class="empty-table">No se encontraron gastos con esos filtros.</td></tr><% } %>
 <% registros.forEach(g=>{ %><tr><td><%= g.ID %></td><td><%= g.DESCRIPCION %></td><td><%= g.MOTIVO||'—' %></td><td><%= fecha(g.FECHA) %></td><td><%= montoFormato(g.MONTO) %></td><td><span class="go-estado <%= String(g.ESTADO||'').toLowerCase() %>"><%= g.ESTADO||'—' %></span></td><td><div class="go-acciones"><a class="go-boton secundario" href="/gastos-operativos/editar/<%= g.ID %>"><i class="fas fa-pen"></i> Editar</a><form method="POST" action="/gastos-operativos/eliminar/<%= g.ID %>" onsubmit="return confirm('¿Eliminar permanentemente este gasto #<%= g.ID %>? Esta acción no se puede deshacer.');"><button class="go-boton peligro" type="submit"><i class="fas fa-trash"></i> Eliminar</button></form></div></td></tr><% }) %>
 </tbody></table></div>
</div>
