<style>
.go-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 14px}
.go-form-grid .form-group input,.go-form-grid .form-group select,.go-form-grid .form-group textarea{width:100%;border:1px solid #d2dbd5;border-radius:8px;padding:10px 12px;min-height:40px;font:inherit;background:#fff}
.go-form-grid .form-group textarea{min-height:70px;resize:vertical}
@media(max-width:580px){.go-form-grid{grid-template-columns:1fr}}
</style>
<div class="dashboard-container">
 <div class="section-heading"><div><p class="section-eyebrow">Gastos Operativos</p><h1 class="section-title"><%= gasto&&gasto.ID?'Editar Gasto Operativo':'Nuevo Gasto Operativo' %></h1><p class="section-description">Completa la información del gasto. Los campos con * son obligatorios.</p></div></div>
 <% if(error){ %><div class="alert alert-error"><i class="fas fa-triangle-exclamation"></i> <%= error %></div><% } %>
 <div class="form-card"><form method="POST" action="<%= accion %>" class="crud-form">
  <div class="go-form-grid">
   <div class="form-group"><label for="go-descripcion">Descripción / categoría *</label><input id="go-descripcion" name="descripcion" maxlength="200" required list="categorias-gasto" placeholder="Ej. Limpieza, Fumigación, Basura" value="<%= gasto?.DESCRIPCION||'' %>"><datalist id="categorias-gasto"><option value="Limpieza"><option value="Fumigación"><option value="Basura"><option value="Agua"><option value="Energía eléctrica"><option value="Mantenimiento"><option value="Alquiler"><option value="Salarios"><option value="Otros"></datalist></div>
   <div class="form-group"><label for="go-motivo">Motivo</label><textarea id="go-motivo" name="motivo" maxlength="200" rows="2" placeholder="Descripción del gasto"><%= gasto?.MOTIVO||'' %></textarea></div>
   <div class="form-group"><label for="go-fecha">Fecha del gasto *</label><input id="go-fecha" type="date" name="fecha_gasto" required value="<%= fecha(gasto?.FECHA) || new Date().toISOString().slice(0,10) %>"></div>
   <div class="form-group"><label for="go-monto">Monto (Q) *</label><input id="go-monto" type="number" name="monto" min="0" max="99999999.99" step="0.01" required value="<%= gasto?.MONTO??'' %>" placeholder="0.00"></div>
   <div class="form-group"><label for="go-estado">Estado</label><select id="go-estado" name="estado"><% ['Pagado','Pendiente','Anulado'].forEach(e=>{ %><option value="<%= e %>" <%= (gasto?.ESTADO||'Pendiente')===e?'selected':'' %>><%= e %></option><% }) %></select></div>
  </div>
  <div class="form-actions"><a class="btn-action btn-delete" href="/gastos-operativos"><i class="fas fa-xmark"></i> Cancelar</a><button class="btn btn-module" type="submit"><i class="fas fa-floppy-disk"></i> <%= gasto&&gasto.ID?'Guardar cambios':'Registrar Gasto' %></button></div>
 </form></div>
</div>
