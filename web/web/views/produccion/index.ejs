<div class="dashboard-container prod-history">

    <div class="section-heading">

        <div>

            <p class="section-eyebrow">
                Gestión de Producción
            </p>

            <h1 class="section-title">
                Producción
            </h1>

            <p class="section-description">
                Consulta el historial y registra
                nuevas producciones.
            </p>

        </div>


        <a
            href="/produccion/nueva"
            class="btn btn-module"
        >
            <i class="fas fa-plus"></i>
            Nueva Producción
        </a>

    </div>


    <% if (mensaje) { %>

        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            <%= mensaje %>
        </div>

    <% } %>


    <% if (error) { %>

        <div class="alert alert-error">
            <i class="fas fa-triangle-exclamation"></i>
            <%= error %>
        </div>

    <% } %>


    <% const registrosProd = (producciones || []).filter(p=>p && p.ID_PRODUCCION); %>
    <% const activasProd = registrosProd.filter(p=>p.ESTADO==='ACTIVA'); %>
    <% const anuladasProd = registrosProd.filter(p=>p.ESTADO==='ANULADA'); %>
    <% const unidadesProd = activasProd.reduce((a,p)=>a+(p.ITEMS||[]).reduce((b,i)=>b+Number(i.cantidad||0),0),0); %>
    <div data-filtro-listado class="prod-filter-panel">
        <label for="buscar-produccion" class="prod-filter-label">Filtrar producciones</label>
        <input id="buscar-produccion" data-filtro-texto type="search" placeholder="Buscar por nombre, producto, fecha o descripción..." autocomplete="off" aria-label="Buscar producciones" style="flex:1;min-width:220px;max-width:440px;padding:9px 11px;border:1px solid #ccd6cf;border-radius:7px;">
        <label class="prod-extra-label">Desde <input id="prod-desde" type="date"></label>
        <label class="prod-extra-label">Hasta <input id="prod-hasta" type="date"></label>
        <label class="prod-extra-label">Estado <select id="prod-estado"><option value="">Todos</option><option value="ACTIVA">Activas</option><option value="ANULADA">Anuladas</option></select></label>
        <button type="button" data-filtro-limpiar style="padding:9px 13px;border:0;border-radius:7px;background:#e8efea;color:#174b26;cursor:pointer;">Limpiar filtros</button>
        <span data-filtro-conteo aria-live="polite" style="width:100%;font-size:13px;color:#365b40;">Registros encontrados: 0</span>
    </div>
    <div class="prod-stats">
      <div><small>Producciones encontradas</small><strong><%= registrosProd.length %></strong></div>
      <div><small>Producciones activas</small><strong><%= activasProd.length %></strong></div>
      <div class="prod-red"><small>Producciones anuladas</small><strong><%= anuladasProd.length %></strong></div>
      <div><small>Unidades en producciones activas</small><strong><%= unidadesProd %></strong></div>
    </div>
    <div class="table-container">

        <table class="data-table">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Producto</th>
                    <th>Cantidad producida</th><th>Estado</th><th>Acciones</th>
                </tr>

            </thead>


            <tbody>

                <% if (
                    !producciones ||
                    producciones.length === 0
                ) { %>

                    <tr>

                        <td
                            colspan="8"
                            class="empty-table"
                        >
                            No hay producciones registradas.
                        </td>

                    </tr>

                <% } else { %>


                    <% producciones.forEach(produccion => { %>
                        <tr data-prod-row data-estado="<%= produccion.ESTADO %>" data-fecha="<%= new Date(produccion.FECHA_PRODUCCION).toISOString().slice(0,10) %>">

                            <td>
                                <%= produccion.ID_PRODUCCION %>
                            </td>


                            <td>

                                <%= new Date(
                                    produccion.FECHA_PRODUCCION
                                ).toLocaleDateString('es-GT') %>

                            </td>


                            <td>

                                <strong>
                                    <%= produccion.NOMBRE %>
                                </strong>

                            </td>


                            <td>
                                <%= produccion.DESCRIPCION || '-' %>
                            </td>


                            <td>
                                <% produccion.ITEMS.forEach(item => { %><div><%= item.nombre %></div><% }); %>
                            </td>


                            <td>
                                <% produccion.ITEMS.forEach(item => { %><div><%= item.cantidad %></div><% }); %>
                            </td>
                            <td><strong style="color:<%= produccion.ESTADO === 'ANULADA' ? '#b91c1c' : '#166534' %>"><%= produccion.ESTADO %></strong></td>
                            <td>
                              <a href="/produccion/<%= produccion.ID_PRODUCCION %>" class="btn-action">Ver detalle</a>
                              <% if (produccion.ESTADO === 'ACTIVA') { %>
                                <button type="button" class="btn-action prod-anular" data-id="<%= produccion.ID_PRODUCCION %>" style="background:#b91c1c;color:white;border:0;cursor:pointer;">Anular</button>
                              <% } else { %>
                                <small><%= produccion.MOTIVO_ANULACION || 'Sin motivo' %></small>
                              <% } %>
                            </td>
                        </tr>

                    <% }); %>


                <% } %>

            </tbody>

        </table>

    </div>

</div>


<div id="prod-modal" style="display:none;position:fixed;inset:0;background:#0009;z-index:1000;align-items:center;justify-content:center;padding:16px;">
  <div role="dialog" aria-modal="true" aria-labelledby="prod-modal-title" style="background:white;padding:22px;border-radius:12px;width:min(100%,430px)">
    <h3 id="prod-modal-title">Anular producción</h3>
    <p>Se descontarán los productos terminados y se devolverán las materias primas. Esta acción no puede deshacerse desde el formulario.</p>
    <form id="prod-anular-form" method="POST">
      <label for="prod-motivo">Motivo de anulación *</label>
      <textarea id="prod-motivo" name="motivo" minlength="5" maxlength="500" required style="display:block;width:100%;min-height:90px;box-sizing:border-box;margin:8px 0;"></textarea>
      <button type="button" id="prod-cancelar" class="btn-action">Cancelar</button>
      <button type="submit" class="btn-action" style="background:#b91c1c;color:white">Confirmar anulación</button>
    </form>
  </div>
</div>
<script>
(() => {
  const modal = document.getElementById('prod-modal');
  const form = document.getElementById('prod-anular-form');
  const motivo = document.getElementById('prod-motivo');
  function cerrar() { modal.style.display = 'none'; }
  document.querySelectorAll('.prod-anular').forEach(btn => btn.addEventListener('click', () => {
    form.action = '/produccion/' + encodeURIComponent(btn.dataset.id) + '/anular';
    document.getElementById('prod-modal-title').textContent = 'Anular producción #' + btn.dataset.id;
    motivo.value = '';
    modal.style.display = 'flex';
    motivo.focus();
  }));
  document.getElementById('prod-cancelar').addEventListener('click', cerrar);
  modal.addEventListener('click', e => { if (e.target === modal) cerrar(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrar(); });
  form.addEventListener('submit', e => {
    if (motivo.value.trim().length < 5) {
      e.preventDefault();
      motivo.setCustomValidity('Escribe al menos 5 caracteres');
      motivo.reportValidity();
    } else motivo.setCustomValidity('');
  });
  motivo.addEventListener('input', () => motivo.setCustomValidity(''));
})();
</script>

<style>
.prod-history .prod-filter-panel{background:#fff;border-radius:12px;padding:17px;margin:14px 0;display:flex;flex-wrap:wrap;align-items:end;gap:12px}
.prod-history .prod-filter-label{font-weight:700;color:#155724;width:100%}
.prod-history .prod-filter-panel>input{flex:2;min-width:200px;max-width:none!important}
.prod-history .prod-extra-label{font-size:12px;font-weight:600;color:#315a3d;display:flex;flex-direction:column;gap:5px;min-width:115px}
.prod-history .prod-extra-label input,.prod-history .prod-extra-label select{border:1px solid #ccd6cf;border-radius:7px;padding:9px;background:white;min-height:37px}
.prod-history .prod-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:12px 0}
.prod-history .prod-stats>div{background:#ecf6ef;padding:13px;border-radius:8px;display:flex;flex-direction:column;gap:6px}
.prod-history .prod-stats small{font-size:12px;color:#315b3c}
.prod-history .prod-stats strong{font-size:19px;color:#155724}
.prod-history .prod-stats .prod-red{background:#fff0f0}
.prod-history .prod-stats .prod-red strong{color:#b91c1c}
.prod-history .table-container{background:#fff;padding:14px;border-radius:12px;overflow-x:auto}
.prod-history .data-table{min-width:760px}
@media(max-width:680px){.prod-history .prod-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script>
(() => {
 const buscar=document.getElementById('buscar-produccion'),desde=document.getElementById('prod-desde'),hasta=document.getElementById('prod-hasta'),estado=document.getElementById('prod-estado');
 const rows=[...document.querySelectorAll('[data-prod-row]')],conteo=document.querySelector('[data-filtro-conteo]');
 const normal=s=>String(s||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();
 function filtrar(){
  let n=0;
  for(const row of rows){
   const visible=normal(row.textContent).includes(normal(buscar.value.trim()))&&(!desde.value||row.dataset.fecha>=desde.value)&&(!hasta.value||row.dataset.fecha<=hasta.value)&&(!estado.value||row.dataset.estado===estado.value);
   row.style.display=visible?'':'none';if(visible)n++;
  }
  if(conteo)conteo.textContent='Registros encontrados: '+n;
 }
 [buscar,desde,hasta,estado].forEach(el=>el.addEventListener(el===buscar?'input':'change',filtrar));
 document.querySelector('[data-filtro-limpiar]').addEventListener('click',()=>{buscar.value='';desde.value='';hasta.value='';estado.value='';filtrar();});
 filtrar();
})();
</script>
