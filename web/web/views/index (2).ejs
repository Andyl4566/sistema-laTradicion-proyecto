<div class="dashboard-container">
  <div class="section-heading"><div><p class="section-eyebrow">Administración</p><h1 class="section-title">Empleados</h1><p class="section-description">Gestiona el personal registrado.</p></div><a class="btn btn-module" href="/empleados/nuevo"><i class="fas fa-plus"></i> Nuevo Empleado</a></div>
  <% if(mensaje){ %><div class="alert alert-success"><i class="fas fa-circle-check"></i> <%= mensaje %></div><% } %>
  <% if(error){ %><div class="alert alert-error"><i class="fas fa-triangle-exclamation"></i> <%= error %></div><% } %>
  <div data-filtro-listado class="empleados-filtros">
    <label for="buscar-empleados">Buscar empleados</label>
    <input id="buscar-empleados" data-filtro-texto type="search" placeholder="Buscar por nombre o DPI..." autocomplete="off" aria-label="Buscar empleados">
    <select id="estado-empleados" aria-label="Filtrar por estado"><option value="todos">Todos los estados</option><option value="activo">Activos</option><option value="inactivo">Inactivos</option></select>
    <button type="button" data-filtro-limpiar>Limpiar filtros</button>
    <span data-filtro-conteo aria-live="polite">Registros encontrados: 0</span>
  </div>
  <div class="table-container"><table class="data-table" id="tablaEmpleados"><thead><tr><th>ID</th><th>Nombre</th><th>DPI</th><th>Teléfono</th><th>Salario</th><th>Contratación</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    <% empleados.forEach(e=>{ %><tr data-estado="<%= (e.ESTADO || '').toLowerCase() %>"><td><%= e.ID_EMPLEADO %></td><td><%= e.NOMBRE %></td><td><%= e.DPI %></td><td><%= e.TELEFONO || '-' %></td><td>Q <%= e.SALARIO == null ? '—' : Number(e.SALARIO).toFixed(2) %></td><td><%= e.FECHA_CONTRATACION ? new Date(e.FECHA_CONTRATACION).toLocaleDateString('es-GT',{timeZone:'UTC'}) : '-' %></td><td><span class="empleados-estado <%= e.ESTADO === 'Inactivo' ? 'inactivo' : 'activo' %>"><%= e.ESTADO || '-' %></span></td><td><div class="empleados-acciones"><a class="btn-action btn-edit" href="/empleados/editar/<%= e.ID_EMPLEADO %>"><i class="fas fa-pen"></i> Editar</a><% if(e.ESTADO !== 'Inactivo'){ %><form method="POST" action="/empleados/desactivar/<%= e.ID_EMPLEADO %>" onsubmit="return confirm('¿Desactivar a este empleado?');"><button type="submit" class="btn-action btn-delete"><i class="fas fa-user-slash"></i> Desactivar</button></form><% } %></div></td></tr><% }) %>
    <% if(!empleados.length){ %><tr><td colspan="8">No hay empleados registrados.</td></tr><% } %>
  </tbody></table></div>
</div>
<style>
.empleados-filtros{background:#fff;border-radius:12px;padding:14px 16px;margin:14px 0;display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.empleados-filtros label{font-weight:600;color:#155724}
.empleados-filtros input,.empleados-filtros select{padding:9px 11px;border:1px solid #ccd6cf;border-radius:7px;background:white;font:inherit}
.empleados-filtros input{flex:1;min-width:190px;max-width:400px}
.empleados-filtros button{padding:9px 13px;border:0;border-radius:7px;background:#e8efea;color:#174b26;cursor:pointer}
.empleados-filtros [data-filtro-conteo]{width:100%;font-size:13px;color:#365b40}
.empleados-acciones{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
.empleados-acciones form{margin:0}
.empleados-acciones .btn-action{font:inherit;font-size:12px;white-space:nowrap;cursor:pointer}
.empleados-estado{font-weight:600}.empleados-estado.activo{color:#17672b}.empleados-estado.inactivo{color:#b42318}
</style>
<script>
(function(){
 const box=document.querySelector('.empleados-filtros');const input=box.querySelector('[data-filtro-texto]');const estado=box.querySelector('#estado-empleados');const limpiar=box.querySelector('[data-filtro-limpiar]');const contador=box.querySelector('[data-filtro-conteo]');const filas=[...document.querySelectorAll('#tablaEmpleados tbody tr[data-estado]')];
 function aplicar(){const q=input.value.trim().toLocaleLowerCase();let n=0;filas.forEach(tr=>{const nombreDpi=tr.cells[1].textContent+' '+tr.cells[2].textContent;const visible=nombreDpi.toLocaleLowerCase().includes(q)&&(estado.value==='todos'||tr.dataset.estado===estado.value);tr.hidden=!visible;if(visible)n++});contador.textContent='Registros encontrados: '+n;}
 input.addEventListener('input',aplicar);estado.addEventListener('change',aplicar);limpiar.addEventListener('click',()=>{input.value='';estado.value='todos';aplicar()});aplicar();
})();
</script>
