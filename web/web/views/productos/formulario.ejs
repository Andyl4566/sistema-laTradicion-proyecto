<div class="dashboard-container">

    <div class="section-heading">

        <div>

            <p class="section-eyebrow">
                Productos
            </p>

            <h1 class="section-title">
                <%= producto ? 'Editar Producto' : 'Nuevo Producto' %>
            </h1>

            <p class="section-description">
                Completa la información del producto.
            </p>

        </div>

    </div>


    <% if (error) { %>

        <div class="alert alert-error">
            <i class="fas fa-triangle-exclamation"></i>
            <%= error %>
        </div>

    <% } %>


    <div class="form-card">

        <form
            action="<%= accion %>"
            method="POST"
            class="crud-form"
        >

            <div class="form-group">

                <label for="nombre">
                    Nombre *
                </label>

                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    maxlength="200"
                    required
                    value="<%= producto ? (producto.NOMBRE || producto.nombre || '') : '' %>"
                    placeholder="Nombre del producto"
                >

            </div>


            <div class="form-group">

                <label for="descripcion">
                    Descripción
                </label>

                <input
                    type="text"
                    id="descripcion"
                    name="descripcion"
                    maxlength="500"
                    value="<%= producto ? (producto.DESCRIPCION || producto.descripcion || '') : '' %>"
                    placeholder="Descripción del producto"
                >

            </div>


            <div class="form-group">

                <label for="unidades">
                    Unidades *
                </label>

                <input
                    type="number"
                    id="unidades"
                    name="unidades"
                    min="0"
                    step="1"
                    required
                    value="<%= producto ? (producto.UNIDADES ?? producto.unidades ?? 0) : 0 %>"
                >

            </div>


            <div class="form-group">

                <label for="precio_unitario">
                    Precio unitario (Q) *
                </label>

                <input
                    type="number"
                    id="precio_unitario"
                    name="precio_unitario"
                    min="0"
                    step="0.01"
                    required
                    value="<%= producto ? (producto.PRECIO_UNITARIO ?? producto.precio_unitario ?? '') : '' %>"
                    placeholder="0.00"
                >

            </div>


            <div class="form-actions">

                <a
                    href="/productos"
                    class="btn-action btn-delete"
                >
                    <i class="fas fa-xmark"></i>
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="btn btn-module"
                >
                    <i class="fas fa-floppy-disk"></i>
                    <%= textoBoton %>
                </button>

            </div>

        </form>

    </div>

</div>