
<style>
/* Mejoras visuales E4: aisladas al módulo Compras */
.compra-panel{background:#fff;border:1px solid #e7eee8;border-radius:14px;padding:20px;margin:16px 0;box-shadow:0 5px 16px rgba(18,67,31,.055)}
.compra-panel-title{font-size:15px;font-weight:750;color:#165c28;margin:0 0 15px}
.compra-metricas{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}
.compra-metrica{background:#edf6ef;border-radius:9px;padding:12px 14px;min-width:0}
.compra-metrica span{display:block;font-size:12px;color:#3c6546;margin-bottom:6px}
.compra-metrica strong{display:block;font-size:18px;color:#125526;overflow-wrap:anywhere}
.compra-metrica--danger{background:#fff0ef}.compra-metrica--danger strong{color:#b91c1c}
.compra-badge{display:inline-flex;align-items:center;border-radius:6px;padding:5px 9px;font-size:12px;font-weight:700}
.compra-badge--activa{background:#e6f6e9;color:#12632b}.compra-badge--anulada{background:#fee9e7;color:#af2020}
.compra-panel .data-table th{background:#155a27;color:#fff}.compra-panel .data-table td{vertical-align:middle}
.compra-panel .data-table tr:hover td{background:#f8fbf8}
.compra-filtros{margin:0;gap:12px}.compra-filtros>div{flex:1 1 140px}.compra-filtros input,.compra-filtros select{box-sizing:border-box;width:100%;max-width:none;min-height:38px}
.compra-acciones .btn-action{background:#edf5ee;color:#165c28;border-radius:6px;padding:8px 10px;text-decoration:none;font-weight:650}
.compra-acciones .btn-action:hover{background:#dcefe0}
.compra-anular{font-weight:650;min-height:34px}
.compra-modal{width:min(100%,480px);border:1px solid #e6eae7;padding:26px}.compra-modal h3{color:#165c28;margin-top:0}.compra-modal p{line-height:1.5;color:#526157}.compra-modal textarea{margin-top:8px;border-color:#d3ddd5}
.compra-fila{border:1px solid #e0eae2;border-radius:10px;background:#fbfdfb;padding:15px;margin:12px 0}
.compra-fila-grid{grid-template-columns:minmax(165px,2fr) minmax(80px,1fr) minmax(105px,1fr) minmax(105px,1fr) auto;gap:10px}
.compra-fila .form-group{min-width:0}.compra-fila .form-group input{width:100%;box-sizing:border-box}.compra-fila .btn-delete{min-height:38px}
.compra-form-head{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.compra-total-box{background:#edf6ef;border-radius:10px;padding:15px;margin-top:16px}
.compra-total-box label{color:#165c28;font-weight:700}.compra-total-box input{background:transparent!important;border:0!important;color:#155b28;font-size:22px;font-weight:750;padding-left:0!important}
.compra-detalle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.compra-detalle-campo{background:#f2f7f3;border-radius:9px;padding:12px;min-width:0}.compra-detalle-campo small{display:block;color:#587360;margin-bottom:6px}.compra-detalle-campo strong{overflow-wrap:anywhere}
.compra-detalle-total{background:#eaf6ec;border-radius:9px;padding:14px;color:#155b28;font-weight:750;font-size:20px;margin-top:14px}
@media(max-width:850px){.compra-metricas{grid-template-columns:repeat(2,minmax(0,1fr))}.compra-fila-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.compra-fila-grid>.compra-form-group:first-child{grid-column:1/-1}.compra-detalle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.compra-panel{padding:13px}.compra-form-head,.compra-detalle-grid{grid-template-columns:1fr}.compra-metricas{gap:7px}.compra-metrica{padding:10px}.compra-metrica strong{font-size:15px}.compra-fila-grid{grid-template-columns:1fr 1fr}}
</style>
<style>.compra-combo{position:relative}.compra-lista{position:absolute;z-index:50;top:100%;width:100%;max-height:200px;overflow:auto;background:white;border:1px solid #bbb;border-radius:6px;box-shadow:0 5px 15px #0002}.compra-lista[hidden]{display:none}.compra-opcion{display:block;width:100%;text-align:left;border:0;background:white;padding:9px;cursor:pointer}.compra-opcion:hover{background:#e5f2e5}.compra-fila{border:1px solid #ddd;border-radius:8px;padding:12px;margin:12px 0}.compra-fila-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:10px;align-items:end}@media(max-width:800px){.compra-fila-grid{grid-template-columns:1fr 1fr}}</style>
<div class="dashboard-container"><div class="section-heading"><div><p class="section-eyebrow">Gestión comercial</p><h1 class="section-title">Nueva Compra</h1><p class="section-description">Registra varias materias primas en una compra. El inventario aumenta automáticamente.</p></div></div><% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
<div class="form-card" style="max-width:900px"><form id="form-compra" class="crud-form" method="post" action="/compras/nueva"><div class="compra-form-head"><div class="form-group"><label>Fecha *</label><input type="date" name="fecha_compra" required value="<%= datos.fecha_compra || '' %>"></div><div class="form-group"><label>Proveedor *</label><div id="proveedor-combo"></div><input type="hidden" name="id_proveedor" id="id_proveedor" required value="<%= datos.id_proveedor || '' %>"></div></div><h3 class="compra-panel-title" style="margin-top:20px">Materias primas de la compra</h3><div id="filas"></div><button class="btn btn-module" type="button" id="agregar">+ Agregar materia prima</button><input type="hidden" name="materias_json" id="materias_json"><div class="form-group compra-total-box"><label>Total estimado</label><input id="total" readonly value="Q 0.00"></div><div class="alert alert-error" id="error-compra" style="display:none"></div><div class="form-actions"><a href="/compras" class="btn-action">Cancelar</a><button type="submit" class="btn btn-module">Registrar Compra</button></div></form></div></div>
<script>
(()=>{
const proveedores=<%- JSON.stringify(proveedores.map(p=>({id:p.ID,nombre:p.NOMBRE,telefono:p.TELEFONO}))).replace(/</g,'\u003c') %>;
const materias=<%- JSON.stringify(materias.map(m=>({id:m.ID,nombre:m.NOMBRE,unidad:m.UNIDAD,costo:m.COSTO}))).replace(/</g,'\u003c') %>;
const inicial=<%- JSON.stringify(datos.materias_json||'').replace(/</g,'\u003c') %>;
const $=id=>document.getElementById(id);let indice=0;
function combo(contenedor,items,placeholder,onSelect,valor=''){
 const caja=document.createElement('div');caja.className='compra-combo';const campo=document.createElement('input');campo.type='text';campo.placeholder=placeholder;campo.autocomplete='off';campo.setAttribute('role','combobox');campo.setAttribute('aria-expanded','false');const lista=document.createElement('div');lista.className='compra-lista';lista.hidden=true;caja.append(campo,lista);contenedor.append(caja);
 const norm=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 const mostrar=()=>{lista.replaceChildren();const t=norm(campo.value);const coincidencias=items.filter(x=>norm(x.nombre).includes(t)).slice(0,80);for(const item of coincidencias){const b=document.createElement('button');b.type='button';b.className='compra-opcion';b.textContent=item.nombre+(item.telefono?' · '+item.telefono:'')+(item.unidad?' ('+item.unidad+')':'');b.addEventListener('mousedown',e=>e.preventDefault());b.addEventListener('click',()=>{campo.value=item.nombre;onSelect(item.id,item);lista.hidden=true;campo.setAttribute('aria-expanded','false');});lista.append(b);}if(!coincidencias.length){const d=document.createElement('div');d.textContent='Sin coincidencias';d.style.padding='10px';lista.append(d);}lista.hidden=false;campo.setAttribute('aria-expanded','true');};
 campo.addEventListener('focus',()=>{campo.select();mostrar()});campo.addEventListener('input',()=>{onSelect('');mostrar()});campo.addEventListener('blur',()=>setTimeout(()=>{lista.hidden=true;campo.setAttribute('aria-expanded','false')},140));campo.addEventListener('keydown',e=>{if(e.key==='Escape')lista.hidden=true;});if(valor){const item=items.find(x=>String(x.id)===String(valor));if(item)campo.value=item.nombre;}return campo;
}
combo($('proveedor-combo'),proveedores,'Buscar proveedor por nombre...',id=>$('id_proveedor').value=id,$('id_proveedor').value);
const filas=[];function agregar(item={}){if(filas.length>=500)return;const fila=document.createElement('div');fila.className='compra-fila';const grid=document.createElement('div');grid.className='compra-fila-grid';fila.append(grid);const selectWrap=document.createElement('div');selectWrap.className='form-group compra-form-group';const lab=document.createElement('label');lab.textContent='Materia prima *';selectWrap.append(lab);grid.append(selectWrap);const actual={id:item.id_materia_prima||'',cantidad:item.cantidad||'',precio_unitario:item.precio_unitario??''};let precioInput;combo(selectWrap,materias,'Buscar materia prima...',(id,seleccion)=>{actual.id=id;if(seleccion && precioInput){const sugerido=Number(seleccion.costo);if(seleccion.costo!==null&&seleccion.costo!==undefined&&Number.isFinite(sugerido)&&sugerido>=0){actual.precio_unitario=sugerido.toFixed(2);precioInput.value=actual.precio_unitario;}}calcular()},actual.id);
 function campo(titulo,valor,step,onChange){const wrap=document.createElement('div');wrap.className='form-group';const l=document.createElement('label');l.textContent=titulo;const inp=document.createElement('input');inp.type='number';inp.min=step==='0.01'?'0.01':'0';inp.step=step;inp.value=valor;inp.required=true;inp.addEventListener('input',()=>{onChange(inp.value);calcular()});wrap.append(l,inp);grid.append(wrap);return inp;}
 campo('Cantidad *',actual.cantidad,'0.01',v=>actual.cantidad=v);precioInput=campo('Precio unitario (Q) *',actual.precio_unitario,'0.01',v=>actual.precio_unitario=v);const subtotal=document.createElement('div');subtotal.className='form-group';subtotal.innerHTML='<label>Subtotal</label>';const salida=document.createElement('input');salida.readOnly=true;subtotal.append(salida);grid.append(subtotal);const quitar=document.createElement('button');quitar.type='button';quitar.className='btn-action btn-delete';quitar.textContent='Quitar';quitar.addEventListener('click',()=>{fila.remove();filas.splice(filas.findIndex(x=>x.fila===fila),1);calcular()});grid.append(quitar);$('filas').append(fila);filas.push({fila,actual,salida});calcular();}
 function calcular(){let total=0;for(const f of filas){const s=Number(f.actual.cantidad)*Number(f.actual.precio_unitario);f.salida.value=Number.isFinite(s)?'Q '+s.toFixed(2):'—';if(Number.isFinite(s))total+=s;}$('total').value='Q '+total.toFixed(2);}
 $('agregar').addEventListener('click',()=>agregar());try{const items=JSON.parse(inicial);if(Array.isArray(items))items.forEach(agregar);}catch(e){}if(!filas.length)agregar();
 $('form-compra').addEventListener('submit',e=>{const err=$('error-compra');err.style.display='none';const items=filas.map(f=>({id_materia_prima:Number(f.actual.id),cantidad:Number(f.actual.cantidad),precio_unitario:Number(f.actual.precio_unitario)}));const ids=new Set(items.map(x=>x.id_materia_prima));if(!$('id_proveedor').value||!items.length||ids.size!==items.length||items.some(x=>!x.id_materia_prima||!Number.isFinite(x.cantidad)||x.cantidad<=0||!Number.isFinite(x.precio_unitario)||x.precio_unitario<0)){e.preventDefault();err.textContent='Seleccione un proveedor y materias primas distintas, con cantidades y precios válidos.';err.style.display='block';return;}$('materias_json').value=JSON.stringify(items);});
})();
</script>
