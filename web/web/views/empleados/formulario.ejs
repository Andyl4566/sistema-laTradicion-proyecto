<div class="dashboard-container">
  <div class="section-heading"><div>
    <p class="section-eyebrow">Administración</p>
    <h1 class="section-title"><%= titulo %></h1>
    <p class="section-description">Completa la información del empleado. Los campos con * son obligatorios.</p>
  </div></div>
  <% if (error) { %><div class="alert alert-error"><i class="fas fa-triangle-exclamation"></i> <%= error %></div><% } %>
  <div class="form-card" style="max-width:760px">
    <form action="<%= accion %>" method="POST" class="crud-form">
      <div class="empleados-form-grid">
        <div class="form-group"><label for="nombre">Nombre *</label><input id="nombre" name="nombre" required maxlength="200" value="<%= empleado?.NOMBRE || '' %>" placeholder="Nombre completo"></div>
        <div class="form-group"><label for="dpi">DPI *</label><input id="dpi" name="dpi" required maxlength="100" value="<%= empleado?.DPI || '' %>" placeholder="DPI del empleado"></div>
        <div class="form-group"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" maxlength="50" value="<%= empleado?.TELEFONO || '' %>" placeholder="Ej. 5555-5555"></div>
        <div class="form-group"><label for="salario">Salario (Q)</label><input id="salario" name="salario" type="number" min="0" step="0.01" value="<%= empleado?.SALARIO ?? '' %>" placeholder="0.00"></div>
        <div class="form-group"><label for="fecha_contratacion">Fecha de contratación</label><input id="fecha_contratacion" name="fecha_contratacion" type="date" value="<%= empleado?.FECHA_CONTRATACION ? fecha(empleado.FECHA_CONTRATACION) : '' %>"></div>
        <div class="form-group"><label for="estado">Estado</label><select id="estado" name="estado" class="empleados-select"><option value="Activo" <%= empleado?.ESTADO !== 'Inactivo'?'selected':'' %>>Activo</option><option value="Inactivo" <%= empleado?.ESTADO === 'Inactivo'?'selected':'' %>>Inactivo</option></select></div>
      </div>
      <div class="form-actions"><a class="btn-action btn-delete" href="/empleados"><i class="fas fa-xmark"></i> Cancelar</a><button class="btn btn-module" type="submit"><i class="fas fa-floppy-disk"></i> <%= empleado?.ID_EMPLEADO ? 'Guardar Cambios' : 'Registrar Empleado' %></button></div>
    </form>
  </div>
</div>
<style>
.empleados-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:18px}
.empleados-select{display:block;width:100%;padding:13px 15px;border:1px solid #d1d5db;border-radius:9px;background:white;font:inherit;min-height:47px}
.empleados-select:focus{outline:none;border-color:#2e7d32;box-shadow:0 0 0 3px rgba(46,125,50,.12)}
@media(max-width:620px){.empleados-form-grid{grid-template-columns:1fr}}
</style>
