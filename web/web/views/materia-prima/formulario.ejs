<div class="dashboard-container">

    <div class="section-heading">

        <div>
            <p class="section-eyebrow">
                Inventario
            </p>

            <h1 class="section-title">
                <%= materiaPrima
                    ? 'Editar Materia Prima'
                    : 'Nueva Materia Prima'
                %>
            </h1>

            <p class="section-description">
                Completa la información del insumo.
            </p>
        </div>

    </div>

    <% if (error) { %>
        <div class="alert alert-error">
            <i class="fas fa-triangle-exclamation"></i>
            <%= error %>
        </div>
    <% } %>

    <div class="form-card">

        <form
            action="<%= accion %>"
            method="POST"
            class="crud-form"
        >

            <div class="form-group">

                <label for="nombre">
                    Nombre *
                </label>

                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    required
                    value="<%= materiaPrima
                        ? (materiaPrima.NOMBRE ||
                           materiaPrima.nombre || '')
                        : ''
                    %>"
                    placeholder="Nombre de la materia prima"
                >

            </div>

            <div class="form-group">

                <label for="descripcion">
                    Descripción
                </label>

                <input
                    type="text"
                    id="descripcion"
                    name="descripcion"
                    value="<%= materiaPrima
                        ? (materiaPrima.DESCRIPCION ||
                           materiaPrima.descripcion || '')
                        : ''
                    %>"
                    placeholder="Descripción del insumo"
                >

            </div>

            <div class="form-group">

                <label for="cantidad">
                    Cantidad disponible *
                </label>

                <input
                    type="number"
                    id="cantidad"
                    name="cantidad"
                    min="0"
                    step="0.01"
                    required
                    value="<%= materiaPrima
                        ? (materiaPrima.CANTIDAD ??
                           materiaPrima.cantidad ?? 0)
                        : 0
                    %>"
                >

            </div>

            <div class="form-group">

                <label for="costo">
                    Costo (Q)
                </label>

                <input
                    type="number"
                    id="costo"
                    name="costo"
                    min="0"
                    step="0.01"
                    value="<%= materiaPrima
                        ? (materiaPrima.COSTO ??
                           materiaPrima.costo ?? '')
                        : ''
                    %>"
                    placeholder="0.00"
                >

            </div>

            <div class="form-actions">

                <a
                    href="/materia-prima"
                    class="btn-action btn-delete"
                >
                    <i class="fas fa-xmark"></i>
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="btn btn-module"
                >
                    <i class="fas fa-floppy-disk"></i>
                    <%= textoBoton %>
                </button>

            </div>

        </form>

    </div>

</div>