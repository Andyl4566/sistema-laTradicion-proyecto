
<style>
/* Mejoras visuales E4: aisladas al módulo Compras */
.compra-panel{background:#fff;border:1px solid #e7eee8;border-radius:14px;padding:20px;margin:16px 0;box-shadow:0 5px 16px rgba(18,67,31,.055)}
.compra-panel-title{font-size:15px;font-weight:750;color:#165c28;margin:0 0 15px}
.compra-metricas{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}
.compra-metrica{background:#edf6ef;border-radius:9px;padding:12px 14px;min-width:0}
.compra-metrica span{display:block;font-size:12px;color:#3c6546;margin-bottom:6px}
.compra-metrica strong{display:block;font-size:18px;color:#125526;overflow-wrap:anywhere}
.compra-metrica--danger{background:#fff0ef}.compra-metrica--danger strong{color:#b91c1c}
.compra-badge{display:inline-flex;align-items:center;border-radius:6px;padding:5px 9px;font-size:12px;font-weight:700}
.compra-badge--activa{background:#e6f6e9;color:#12632b}.compra-badge--anulada{background:#fee9e7;color:#af2020}
.compra-panel .data-table th{background:#155a27;color:#fff}.compra-panel .data-table td{vertical-align:middle}
.compra-panel .data-table tr:hover td{background:#f8fbf8}
.compra-filtros{margin:0;gap:12px}.compra-filtros>div{flex:1 1 140px}.compra-filtros input,.compra-filtros select{box-sizing:border-box;width:100%;max-width:none;min-height:38px}
.compra-acciones .btn-action{background:#edf5ee;color:#165c28;border-radius:6px;padding:8px 10px;text-decoration:none;font-weight:650}
.compra-acciones .btn-action:hover{background:#dcefe0}
.compra-anular{font-weight:650;min-height:34px}
.compra-modal{width:min(100%,480px);border:1px solid #e6eae7;padding:26px}.compra-modal h3{color:#165c28;margin-top:0}.compra-modal p{line-height:1.5;color:#526157}.compra-modal textarea{margin-top:8px;border-color:#d3ddd5}
.compra-fila{border:1px solid #e0eae2;border-radius:10px;background:#fbfdfb;padding:15px;margin:12px 0}
.compra-fila-grid{grid-template-columns:minmax(165px,2fr) minmax(80px,1fr) minmax(105px,1fr) minmax(105px,1fr) auto;gap:10px}
.compra-fila .form-group{min-width:0}.compra-fila .form-group input{width:100%;box-sizing:border-box}.compra-fila .btn-delete{min-height:38px}
.compra-form-head{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.compra-total-box{background:#edf6ef;border-radius:10px;padding:15px;margin-top:16px}
.compra-total-box label{color:#165c28;font-weight:700}.compra-total-box input{background:transparent!important;border:0!important;color:#155b28;font-size:22px;font-weight:750;padding-left:0!important}
.compra-detalle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.compra-detalle-campo{background:#f2f7f3;border-radius:9px;padding:12px;min-width:0}.compra-detalle-campo small{display:block;color:#587360;margin-bottom:6px}.compra-detalle-campo strong{overflow-wrap:anywhere}
.compra-detalle-total{background:#eaf6ec;border-radius:9px;padding:14px;color:#155b28;font-weight:750;font-size:20px;margin-top:14px}
@media(max-width:850px){.compra-metricas{grid-template-columns:repeat(2,minmax(0,1fr))}.compra-fila-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.compra-fila-grid>.compra-form-group:first-child{grid-column:1/-1}.compra-detalle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.compra-panel{padding:13px}.compra-form-head,.compra-detalle-grid{grid-template-columns:1fr}.compra-metricas{gap:7px}.compra-metrica{padding:10px}.compra-metrica strong{font-size:15px}.compra-fila-grid{grid-template-columns:1fr 1fr}}
</style>
<style>
.compra-filtros{display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin:14px 0}.compra-filtros label{display:block;font-size:12px;font-weight:600;margin-bottom:5px}.compra-filtros input,.compra-filtros select{padding:8px;border:1px solid #ccd6cc;border-radius:6px;max-width:220px}.compra-modal-fondo{position:fixed;inset:0;background:#0009;z-index:1000;display:none;align-items:center;justify-content:center;padding:18px}.compra-modal{background:white;border-radius:12px;padding:22px;width:min(100%,420px);box-shadow:0 10px 35px #0004}.compra-modal textarea{width:100%;min-height:85px;padding:10px;border:1px solid #bbb;border-radius:6px;box-sizing:border-box}.compra-acciones{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.compra-anular{border:0;border-radius:6px;background:#b91c1c;color:white;padding:8px 12px;cursor:pointer}.compra-estado-activa{color:green;font-weight:bold}.compra-estado-anulada{color:#b91c1c;font-weight:bold}
</style>
<div class="dashboard-container"><div class="section-heading"><div><p class="section-eyebrow">Gestión comercial</p><h1 class="section-title">Compras</h1><p class="section-description">Historial de compras a proveedores.</p></div><a class="btn btn-module" href="/compras/nueva">+ Nueva Compra</a></div>
<% if(mensaje){ %><div class="alert alert-success"><%= mensaje %></div><% } %><% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
<div class="compra-panel"><h2 class="compra-panel-title">Filtrar compras</h2><div class="compra-filtros"><div><label for="f-proveedor">Proveedor</label><input id="f-proveedor" placeholder="Buscar proveedor..."></div><div><label for="f-desde">Desde</label><input type="date" id="f-desde"></div><div><label for="f-hasta">Hasta</label><input type="date" id="f-hasta"></div><div><label for="f-estado">Estado</label><select id="f-estado"><option value="">Todas</option><option value="ACTIVA">Activas</option><option value="ANULADA">Anuladas</option></select></div><button type="button" class="btn-action" id="f-limpiar">Limpiar</button></div>
<div class="compra-metricas" aria-live="polite"><div class="compra-metrica"><span>Compras encontradas</span><strong id="compra-cantidad">0</strong></div><div class="compra-metrica"><span>Total de compras activas</span><strong id="compra-total">Q 0.00</strong></div><div class="compra-metrica"><span>Compras activas</span><strong id="compra-activas">0</strong></div><div class="compra-metrica compra-metrica--danger"><span>Compras anuladas</span><strong id="compra-anuladas">0</strong></div></div><p id="compra-resumen" aria-live="polite" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)"></p></div>
<div class="compra-panel"><div class="table-container"><table class="data-table" style="width:100%"><thead><tr><th>ID</th><th>Fecha</th><th>Proveedor</th><th>Materias primas</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<% compras.forEach(c=>{ const fecha=new Date(c.FECHA).toISOString().slice(0,10); %><tr class="compra-registro" data-proveedor="<%= c.PROVEEDOR %>" data-fecha="<%= fecha %>" data-estado="<%= c.ESTADO %>" data-monto="<%= c.MONTO %>"><td><%= c.ID %></td><td><%= new Date(c.FECHA).toLocaleDateString('es-GT',{timeZone:'UTC'}) %></td><td><%= c.PROVEEDOR %></td><td><%= c.TIPOS %></td><td>Q <%= Number(c.MONTO).toFixed(2) %></td><td><span class="compra-badge <%= c.ESTADO==='ANULADA'?'compra-badge--anulada':'compra-badge--activa' %>"><%= c.ESTADO==='ANULADA'?'Anulada':'Activa' %></span></td><td><div class="compra-acciones"><a href="/compras/<%= c.ID %>" class="btn-action">Ver detalle</a><% if(c.ESTADO==='ACTIVA'){ %><button type="button" class="compra-anular" data-id="<%= c.ID %>">Anular</button><% }else{ %><span style="font-size:12px;max-width:220px;overflow-wrap:anywhere"><%= c.MOTIVO_ANULACION || 'Sin motivo' %></span><% } %></div></td></tr><% }) %>
</tbody></table><p id="compra-sin-resultados" hidden>No hay compras que coincidan con los filtros.</p></div></div></div>
<div id="compra-modal-fondo" class="compra-modal-fondo" role="presentation"><div class="compra-modal" role="dialog" aria-modal="true" aria-labelledby="compra-modal-titulo"><h3 id="compra-modal-titulo">Anular compra</h3><p>Se descontarán del inventario las materias primas de esta compra. La operación no puede deshacerse desde este formulario.</p><form id="compra-form-anular" method="post"><label for="compra-motivo">Motivo de anulación *</label><textarea id="compra-motivo" name="motivo" minlength="5" maxlength="500" required placeholder="Escribe el motivo (mínimo 5 caracteres)"></textarea><div style="display:flex;justify-content:end;gap:8px;margin-top:12px"><button type="button" id="compra-cancelar" class="btn-action">Cancelar</button><button type="submit" class="compra-anular">Confirmar anulación</button></div></form></div></div>
<script>(()=>{const rows=[...document.querySelectorAll('.compra-registro')],f=['f-proveedor','f-desde','f-hasta','f-estado'].map(id=>document.getElementById(id));const norm=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();function filtrar(){let cantidad=0,total=0,activas=0,anuladas=0;for(const r of rows){const [p,desde,hasta,estado]=f.map(x=>x.value);const ok=norm(r.dataset.proveedor).includes(norm(p))&&(!desde||r.dataset.fecha>=desde)&&(!hasta||r.dataset.fecha<=hasta)&&(!estado||r.dataset.estado===estado);r.hidden=!ok;if(ok){cantidad++;if(r.dataset.estado==='ACTIVA'){total+=Number(r.dataset.monto)||0;activas++;}else if(r.dataset.estado==='ANULADA')anuladas++;}}document.getElementById('compra-cantidad').textContent=cantidad;document.getElementById('compra-total').textContent='Q '+total.toFixed(2);document.getElementById('compra-activas').textContent=activas;document.getElementById('compra-anuladas').textContent=anuladas;document.getElementById('compra-resumen').textContent='Compras encontradas: '+cantidad+' · Total de compras activas filtradas: Q '+total.toFixed(2);document.getElementById('compra-sin-resultados').hidden=cantidad!==0;}f.forEach(x=>x.addEventListener('input',filtrar));document.getElementById('f-limpiar').onclick=()=>{f.forEach(x=>x.value='');filtrar()};filtrar();const fondo=document.getElementById('compra-modal-fondo'),form=document.getElementById('compra-form-anular'),motivo=document.getElementById('compra-motivo');document.querySelectorAll('.compra-anular[data-id]').forEach(b=>b.addEventListener('click',()=>{form.action='/compras/'+encodeURIComponent(b.dataset.id)+'/anular';document.getElementById('compra-modal-titulo').textContent='Anular compra #'+b.dataset.id;motivo.value='';fondo.style.display='flex';motivo.focus()}));function cerrar(){fondo.style.display='none'}document.getElementById('compra-cancelar').onclick=cerrar;fondo.addEventListener('click',e=>{if(e.target===fondo)cerrar()});document.addEventListener('keydown',e=>{if(e.key==='Escape')cerrar()});form.addEventListener('submit',e=>{if(motivo.value.trim().length<5){e.preventDefault();motivo.setCustomValidity('Indique un motivo de al menos 5 caracteres.');motivo.reportValidity()}else motivo.setCustomValidity('')});motivo.addEventListener('input',()=>motivo.setCustomValidity(''));})();</script>
