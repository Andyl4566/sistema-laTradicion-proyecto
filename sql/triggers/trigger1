* Cuando se agregue un producto a una venta, el sistema debe comprobar que exista suficiente inventario y, si existe, descontar automáticamente la cantidad vendida. *
/*
============================================================
Archivo: trg_validar_stock_venta.sql
Entrega: Entrega 3
Descripción:
Valida la disponibilidad de inventario antes de registrar
un producto dentro de una venta.
Regla de negocio:
No se permite registrar una cantidad menor o igual a cero
ni vender una cantidad superior al inventario disponible.
Dependencias:
- producto
- producto_venta
============================================================
*/
USE bd_tradicion;
DELIMITER $$
DROP TRIGGER IF EXISTS trg_validar_stock_venta$$
CREATE TRIGGER trg_validar_stock_venta
BEFORE INSERT ON producto_venta
FOR EACH ROW
BEGIN
DECLARE stock_disponible INT;
SELECT unidades
INTO stock_disponible
FROM producto
WHERE id_producto = NEW.id_producto;
IF stock_disponible IS NULL THEN
SIGNAL SQLSTATE '45000'
SET MESSAGE_TEXT = 'El producto no existe';
END IF;
IF NEW.cantidad <= 0 THEN
SIGNAL SQLSTATE '45000'
SET MESSAGE_TEXT = 'La cantidad vendida debe ser mayor que cero';
END IF;
IF stock_disponible < NEW.cantidad THEN
SIGNAL SQLSTATE '45000'
SET MESSAGE_TEXT = 'Stock insuficiente para realizar la venta';
END IF;
END$$
DELIMITER ;
