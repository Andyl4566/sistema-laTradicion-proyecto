USE bd_tradicion;

DELIMITER $$

DROP PROCEDURE IF EXISTS sp_registrar_venta$$

CREATE PROCEDURE sp_registrar_venta(
    IN p_asunto VARCHAR(200),
    IN p_fecha_venta DATE,
    IN p_id_empleado INT,
    IN p_id_cliente INT,
    IN p_id_producto INT,
    IN p_cantidad INT,
    IN p_precio_unitario DECIMAL(10,2)
)
BEGIN
    DECLARE v_id_venta INT;
    DECLARE v_total DECIMAL(10,2);

    /*
      Si ocurre cualquier error durante la operación,
      se revierten todos los cambios.
    */
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    /* Validar cliente */
    IF NOT EXISTS (
        SELECT 1
        FROM cliente
        WHERE id_cliente = p_id_cliente
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'El cliente indicado no existe';
    END IF;

    /* Validar empleado */
    IF NOT EXISTS (
        SELECT 1
        FROM empleado
        WHERE id_empleado = p_id_empleado
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'El empleado indicado no existe';
    END IF;

    /* Validar cantidad */
    IF p_cantidad <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'La cantidad debe ser mayor que cero';
    END IF;

    SET v_total = p_cantidad * p_precio_unitario;

    /*
      Generamos el siguiente ID porque venta actualmente
      no utiliza AUTO_INCREMENT.
    */
    SELECT COALESCE(MAX(id_venta), 0) + 1
    INTO v_id_venta
    FROM venta;

    INSERT INTO venta (
        id_venta,
        asunto,
        fecha_venta,
        monto,
        id_empleado,
        id_cliente
    )
    VALUES (
        v_id_venta,
        p_asunto,
        p_fecha_venta,
        v_total,
        p_id_empleado,
        p_id_cliente
    );

    /*
      Al ejecutar este INSERT entran en acción:
      - trg_validar_stock_venta
      - trg_descontar_stock_venta
    */
    INSERT INTO producto_venta (
        id_venta,
        id_producto,
        cantidad,
        precio_unitario
    )
    VALUES (
        v_id_venta,
        p_id_producto,
        p_cantidad,
        p_precio_unitario
    );

    COMMIT;

    /* Devolver información de la venta creada */
    SELECT
        v_id_venta AS id_venta,
        v_total AS total,
        'Venta registrada correctamente' AS mensaje;

END$$

DELIMITER ;
